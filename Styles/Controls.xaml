<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- ACCENT BUTTON — cyan gradient, dark text                            -->
    <!-- ================================================================== -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#06222e" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3dc7eb" Offset="0" />
                    <GradientStop Color="#2ba6d4" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- GHOST BUTTON — transparent with subtle border                       -->
    <!-- ================================================================== -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#0FFFFFFF" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- STATUS BADGE — small rounded pill                                   -->
    <!-- ================================================================== -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <!-- ================================================================== -->
    <!-- METRIC CARD — small data card in Results panel                      -->
    <!-- ================================================================== -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="13,14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#08FFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#0DFFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ================================================================== -->
    <!-- SECTION CARD — settings/results card wrapper                        -->
    <!-- ================================================================== -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="15" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#08FFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#0DFFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ================================================================== -->
    <!-- SECTION LABEL — uppercase category labels                           -->
    <!-- ================================================================== -->
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ================================================================== -->
    <!-- MONO TEXT — monospace numeric display                                -->
    <!-- ================================================================== -->
    <Style x:Key="MonoValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, ui-monospace" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

</ResourceDictionary>
