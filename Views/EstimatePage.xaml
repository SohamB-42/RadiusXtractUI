<UserControl
    x:Class="RadiusXtractUI.Views.EstimatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COMMAND BAR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}"
                        Click="OnOpenFileClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="14" Height="14" Margin="0,-2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                        Command="{x:Bind ViewModel.RunEstimateCommand}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3-8c0 1.66-1.34 3-3 3s-3-1.34-3-3 1.34-3 3-3 3 1.34 3 3z" Width="14" Height="14" Margin="0,-2,0,0"/>
                        <TextBlock Text="Estimate radius" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="2" Width="1" Height="22" Background="{StaticResource BorderMediumBrush}" Margin="12,0"/>

                <Border Grid.Column="3" Height="30" CornerRadius="6" Background="{StaticResource CardBgBrush}" Padding="11,0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="#f5b754" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveFileName, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="5" Style="{StaticResource GhostButtonStyle}" Click="OnConsoleClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M20 4H4c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.89-2-2-2zm0 14H4V8h16v10zm-2-1h-6v-2h6v2zM7.5 17l-1.41-1.41L8.67 13l-2.58-2.59L7.5 9l4 4-4 4z" Width="14" Height="14" Margin="0,-2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Console" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- VIEWPORT AREA -->
            <Border Grid.Column="0" Background="{StaticResource ViewportBgBrush}">
                <Grid>
                    <WebView2 x:Name="GpuViewport" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <!-- Floating toolbar -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                            Background="#D9161a20" CornerRadius="8" Padding="4"
                            BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                    Click="OnResetViewClick" ToolTipService.ToolTip="Reset View">
                                <FontIcon Glyph="&#xE7AD;" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                    Click="OnResetViewClick" ToolTipService.ToolTip="Fit to View">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                    Click="OnToggleOverlayClick" ToolTipService.ToolTip="Toggle 3D Cylinder Overlay">
                                <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- EMPTY STATE -->
                    <Border Background="#E60e1013" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <Border Width="430" Padding="42,38" CornerRadius="14"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5"
                                Background="{StaticResource BackgroundDarkBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                PointerPressed="OnEmptyStateClick">
                            <StackPanel Spacing="7">
                                <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="30" Height="30" HorizontalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,11"/>
                                <TextBlock Text="Load a point cloud" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Drop a file here or click to browse." HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,0"/>
                                <TextBlock Text=".pcd · .ply · .las · .xyz" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- ESTIMATING OVERLAY -->
                    <Border Background="#D9000000" Visibility="{x:Bind ViewModel.IsEstimating, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                            <TextBlock Text="{x:Bind ViewModel.EstimateProgress, Mode=OneWay, Converter={StaticResource ProgressTextConverter}}"
                                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Estimating cylinder radius…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL WRAPPER -->
            <Grid Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ResultsPanelTransform" X="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ToggleResultsButton" Grid.Column="0" Width="28" Height="48" VerticalAlignment="Center"
                        CornerRadius="6,0,0,6" Background="{StaticResource PanelBgBrush}" 
                        BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1,1,0,1"
                        Click="OnToggleResultsClick" ToolTipService.ToolTip="Toggle Results" Padding="0">
                    <FontIcon x:Name="ToggleResultsIcon" Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <!-- RIGHT PANEL -->
                <Border x:Name="ResultsPanel" Grid.Column="1" Width="368" Background="{StaticResource PanelBgBrush}"
                        BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                    <StackPanel>
                        <!-- HAS RESULT -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="ESTIMATION RESULT" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0"/>
                                <Border HorizontalAlignment="Right" Height="24" Padding="9,0" CornerRadius="12" Background="#1c3828">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#6fe0a3" VerticalAlignment="Center"/>
                                        <TextBlock Text="Good fit" FontSize="11.5" FontWeight="SemiBold" Foreground="#6fe0a3" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Hero card -->
                            <Border Style="{StaticResource SectionCardStyle}" Background="#0d1a24" BorderBrush="#1e4654" Padding="18,20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Estimated radius" FontSize="12" Foreground="#8f97a0"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.RadiusDisplay, Mode=OneWay}" FontSize="40" FontWeight="SemiBold" Style="{StaticResource MonoValueStyle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedUnit, Mode=OneWay}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    </StackPanel>
                                    <Grid Margin="0,16,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RbMm" Grid.Column="0" IsChecked="True" Checked="OnUnitChanged" Tag="mm" Style="{StaticResource CardRadioButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="mm" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="millimeters" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RbM" Grid.Column="1" Checked="OnUnitChanged" Tag="m" Style="{StaticResource CardRadioButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="m" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="meters" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RbIn" Grid.Column="2" Checked="OnUnitChanged" Tag="in" Style="{StaticResource CardRadioButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="in" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="inches" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2x2 Grid -->
                            <Grid Margin="0,0,0,12" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Diameter" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,5,0,0">
                                            <TextBlock Text="{x:Bind ViewModel.DiameterDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource MonoValueStyle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Length / extent" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,5,0,0">
                                            <TextBlock Text="{x:Bind ViewModel.LengthDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource MonoValueStyle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Inlier points" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="58,669" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" Style="{StaticResource MonoValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Total points" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="63,086" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" Style="{StaticResource MonoValueStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Confidence & RMS -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Fit confidence" FontSize="12.5" Foreground="#c2c8cf"/>
                                        <TextBlock Text="{x:Bind ViewModel.ConfidenceDisplay, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#6fe0a3" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="6" CornerRadius="3" Background="{StaticResource BorderMediumBrush}">
                                        <!-- Fake width for 97% of ~290px container -->
                                        <Border Height="6" CornerRadius="3" Background="{StaticResource AccentCyanBrush}" HorizontalAlignment="Left" Width="280"/>
                                    </Border>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="RMS error" FontSize="11.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.RmsDisplay, Mode=OneWay}" FontSize="11.5" Foreground="#c2c8cf" Style="{StaticResource MonoValueStyle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedUnit, Mode=OneWay}" FontSize="11.5" Foreground="#c2c8cf" Style="{StaticResource MonoValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Axis & Inclination -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Cylinder axis &amp; orientation" FontSize="12.5" Foreground="#c2c8cf" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,11" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="8" Background="{StaticResource BackgroundDarkBrush}" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="X" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentRedAxisBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="0.018" FontSize="13" Foreground="#dfe3e8" HorizontalAlignment="Center" Style="{StaticResource MonoValueStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource BackgroundDarkBrush}" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="Y" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="0.072" FontSize="13" Foreground="#dfe3e8" HorizontalAlignment="Center" Style="{StaticResource MonoValueStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="8" Background="{StaticResource BackgroundDarkBrush}" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="Z" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="0.997" FontSize="13" Foreground="#dfe3e8" HorizontalAlignment="Center" Style="{StaticResource MonoValueStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Inclination from horizontal" FontSize="11.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="4.2°" FontSize="11.5" Foreground="#c2c8cf" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="CopyButton" Grid.Column="0" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" Height="36" Click="OnCopyClick">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="14" Height="14" Margin="0,-2,0,0"/><TextBlock Text="Copy"/></StackPanel>
                                </Button>
                                <Button x:Name="ExportButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="36" Click="OnExportClick">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z" Width="14" Height="14" Margin="0,-2,0,0"/><TextBlock Text="Export report"/></StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- NO RESULT -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Margin="0,40,0,20" HorizontalAlignment="Center">
                            <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3-8c0 1.66-1.34 3-3 3s-3-1.34-3-3 1.34-3 3-3 3 1.34 3 3z" Width="26" Height="26" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="No result yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Load a point cloud and run Estimate radius to see measurements here." TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Width="230"/>
                        </StackPanel>

                        <!-- DISPLAY SETTINGS -->
                        <Border Margin="0,20,0,0" Padding="0,24,0,0" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="COLOR MODE" Style="{StaticResource SectionLabelStyle}"/>
                                <Grid ColumnSpacing="8" Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbAxis" Grid.Column="0" Content="Axis" IsChecked="True" Tag="axis" Checked="OnColorModeChanged" Style="{StaticResource SegmentedRadioButtonStyle}" />
                                    <RadioButton x:Name="RbDepth" Grid.Column="1" Content="Depth" Tag="depth" Checked="OnColorModeChanged" Style="{StaticResource SegmentedRadioButtonStyle}" />
                                    <RadioButton x:Name="RbSolid" Grid.Column="2" Content="Solid" Tag="solid" Checked="OnColorModeChanged" Style="{StaticResource SegmentedRadioButtonStyle}" />
                                </Grid>

                                <TextBlock Text="POINT SIZE" Style="{StaticResource SectionLabelStyle}"/>
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="1" Maximum="5" StepFrequency="0.2" Value="{x:Bind ViewModel.PointSize, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PointSizeLabel, Mode=OneWay}" FontSize="13" Foreground="#c2c8cf" Style="{StaticResource MonoValueStyle}" Width="34" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="LAYERS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                <StackPanel Spacing="4">
                                    <!-- Fitted cylinder toggle -->
                                    <Border CornerRadius="9" Padding="13,11" Background="{StaticResource HoverOverlayBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Fitted cylinder" FontSize="13" Foreground="#dfe3e8" TextWrapping="Wrap"/>
                                                <TextBlock Text="Overlay the RANSAC model" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowOverlay, Mode=TwoWay}" MinWidth="0" Margin="0,-6,0,-6"/>
                                        </Grid>
                                    </Border>
                                    <!-- Show outliers toggle -->
                                    <Border CornerRadius="9" Padding="13,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Show outliers" FontSize="13" Foreground="#dfe3e8" TextWrapping="Wrap"/>
                                                <TextBlock Text="Highlight rejected points in red" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowOutliers, Mode=TwoWay}" MinWidth="0" Margin="0,-6,0,-6"/>
                                        </Grid>
                                    </Border>
                                    <!-- Reference grid toggle -->
                                    <Border CornerRadius="9" Padding="13,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Reference grid" FontSize="13" Foreground="#dfe3e8" TextWrapping="Wrap"/>
                                                <TextBlock Text="Background measurement grid" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" MinWidth="0" Margin="0,-6,0,-6"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
