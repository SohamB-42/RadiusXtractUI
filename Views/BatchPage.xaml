<UserControl
    x:Class="RadiusXtractUI.Views.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RadiusXtractUI.Models">

    <Grid Background="{StaticResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COMMAND BAR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Batch processing" FontSize="15" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="12" Height="12" Margin="0,-2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Add files" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M8 5v14l11-7z" Width="12" Height="12" Margin="0,-1,0,0"/>
                        <TextBlock Text="Start batch" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="24">
                
                <!-- STAT CARDS -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total files" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalFiles, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" Style="{StaticResource MonoValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Completed" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CompletedFiles, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,0" Style="{StaticResource MonoValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="In progress" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.InProgressFiles, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" Style="{StaticResource MonoValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Failed" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.FailedFiles, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" Margin="0,4,0,0" Style="{StaticResource MonoValueStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FILE LIST -->
                <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Background="#0b0d10" Padding="0,8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BatchFileItem">
                                <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding DotColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding PointCount}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Style="{StaticResource MonoValueStyle}"/>
                                        
                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                        </Border>

                                        <!-- Radius / Progress -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding RadiusDisplay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource MonoValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
