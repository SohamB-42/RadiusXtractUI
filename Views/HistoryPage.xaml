<UserControl
    x:Class="RadiusXtractUI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RadiusXtractUI.Models">

    <Grid Background="{StaticResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COMMAND BAR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Measurement history" FontSize="15" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                <Border Grid.Column="1" Height="24" CornerRadius="12" Background="{StaticResource CardBgBrush}" Padding="11,0" Margin="14,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.RunCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z" Width="12" Height="12" Margin="0,-2,0,0"/>
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryItem">
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource BackgroundDarkBrush}" Margin="0,0,16,0">
                                    <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Width="18" Height="18" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Date}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Points:" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="{Binding PointCount}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource MonoValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Method:" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="{Binding Method}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Radius:" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="{Binding RadiusDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Style="{StaticResource MonoValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Diameter:" FontSize="12.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        <TextBlock Text="{Binding DiameterDisplay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource MonoValueStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Fit Badge -->
                                <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Height="28" CornerRadius="14" Padding="12,0" Background="#22262c">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!-- Note: Real implementation would bind color, here we mock it visually -->
                                        <TextBlock Text="Fit:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FitLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
